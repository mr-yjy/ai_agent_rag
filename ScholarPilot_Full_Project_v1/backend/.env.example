# Copy this file to backend/.env. Keep every real credential out of Git.

# Required internal credential used only between the web API route and Python.
# Generate a random value of at least 32 bytes for each environment.
BACKEND_PROXY_TOKEN=

# Exact comma-separated frontend origins. Wildcards are intentionally unsupported.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
MAX_CONCURRENT_SEARCHES=4

# LLM provider metadata. Users supply credentials in the web settings.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
LLM_THINKING_MODE=disabled
LLM_REASONING_EFFORT=high
LLM_JSON_MODE=true
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=8
LLM_MAX_RETRIES=1
LLM_RETRY_BACKOFF=0.75

# Academic APIs
OPENALEX_API_KEY=
OPENALEX_MAILTO=
SEMANTIC_SCHOLAR_API_KEY=
MAX_RESULTS_PER_QUERY=25
REQUEST_TIMEOUT=15

# Search-agent cost and latency budgets
MAX_SEARCH_ROUNDS=3
MAX_API_CALLS_PER_ROUND=5
MAX_TOTAL_API_CALLS=10
MAX_TOTAL_PAPERS=100
INITIAL_SUBQUERY_LIMIT=3
DESIRED_CANDIDATE_COUNT=20
ENABLE_CITATION_EXPANSION=true
SELECTOR_BATCH_SIZE=8
SELECTOR_MAX_PAPERS=32
LLM_RERANK_TOP_K=12
COUNTERFACTUAL_MAX_PAPERS=4
SEARCH_TIMEOUT_SECONDS=50
OPTIONAL_STEP_MIN_REMAINING_SECONDS=2
CACHE_TTL_SECONDS=600

# CausalTrust / When-to-Trust calibration
CAUSAL_TRUST_ENABLED=true
CAUSAL_TRUST_EVIDENCE_INTERVENTION=true
CAUSAL_TRUST_REASONING_INTERVENTION=true
CAUSAL_TRUST_PANEL_ENABLED=true
CAUSAL_TRUST_CCI_ENABLED=true
CAUSAL_TRUST_STABILITY_PENALTY=true
CAUSAL_TRUST_ACCEPT_THRESHOLD=0.75
CAUSAL_TRUST_RETRY_THRESHOLD=0.50
CAUSAL_TRUST_MARGIN_THRESHOLD=0.15
CAUSAL_TRUST_MAX_RETRIES=1
CAUSAL_TRUST_RETRIEVAL_RECOVERY=true
CAUSAL_TRUST_REASONING_RECOVERY=true
CAUSAL_TRUST_MAX_EVIDENCE_ITEMS=12
CAUSAL_TRUST_MIN_EVIDENCE_ITEMS=3
CAUSAL_TRUST_MIN_REMAINING_SECONDS=10
CAUSAL_TRUST_TRACE_ENABLED=true

# Transparent ranking configuration (weights are normalized at runtime).
RANK_WEIGHT_RELEVANCE=0.45
RANK_WEIGHT_CONSTRAINTS=0.23
RANK_WEIGHT_EVIDENCE=0.10
RANK_WEIGHT_AUTHORITY=0.08
RANK_WEIGHT_RECENCY=0.07
RANK_WEIGHT_SOURCE_CONSISTENCY=0.04
RANK_WEIGHT_OPENNESS=0.03
MMR_DUPLICATE_PENALTY=8
