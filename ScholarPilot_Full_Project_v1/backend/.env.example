# Copy this file to backend/.env. Never commit the real .env file.

# DeepSeek V4 Pro (required for LLM query analysis/ranking)
LLM_API_KEY=sk-baec575a040742c3bd4ff0e0e02f24ce
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
LLM_THINKING_MODE=disabled
LLM_REASONING_EFFORT=high
