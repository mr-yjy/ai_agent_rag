{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scholarpilot.example/schemas/search-response-v1.schema.json",
  "title": "ScholarPilot Search Response v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "requestId",
    "status",
    "provider",
    "queryPlan",
    "results",
    "sourceStatus",
    "stats"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "requestId": { "type": "string", "minLength": 8, "maxLength": 80 },
    "status": { "enum": ["success", "no_results", "degraded"] },
    "degraded": { "type": "boolean" },
    "provider": { "type": "string" },
    "queryPlan": { "$ref": "query-contract-v1.schema.json" },
    "results": { "type": "array", "items": { "type": "object" } },
    "sourceStatus": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "status", "apiCalls", "resultCount"],
        "properties": {
          "source": { "type": "string" },
          "status": {
            "enum": [
              "success",
              "partial",
              "failed",
              "timeout",
              "rate_limited",
              "cancelled"
            ]
          },
          "apiCalls": { "type": "integer", "minimum": 0 },
          "resultCount": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "reliability": {
      "type": "object",
      "required": [
        "status",
        "answer",
        "confidence",
        "decision",
        "message"
      ],
      "properties": {
        "status": {
          "enum": ["completed", "skipped", "failed"]
        },
        "answer": { "type": "string" },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "decision": {
          "enum": [
            "ACCEPT",
            "RETRY_RETRIEVAL",
            "RETRY_REASONING",
            "ABSTAIN",
            "NOT_RUN"
          ]
        },
        "message": { "type": "string" },
        "reason": { "type": "string" },
        "selectedCandidateId": { "type": "string" },
        "diagnosis": {
          "type": "object",
          "properties": {
            "evidenceRisk": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "reasoningRisk": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "recommendedRecovery": { "type": "string" }
          }
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "value",
              "meanSupport",
              "instability",
              "cci",
              "interventionScores"
            ],
            "properties": {
              "id": { "type": "string" },
              "value": { "type": "string" },
              "meanSupport": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "instability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "cci": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "interventionScores": { "type": "object" }
            }
          }
        },
        "recovery": {
          "type": "object",
          "required": ["attempted", "mode", "attempts", "recovered"],
          "properties": {
            "attempted": { "type": "boolean" },
            "mode": { "type": "string" },
            "attempts": { "type": "integer", "minimum": 0, "maximum": 1 },
            "recovered": { "type": "boolean" }
          }
        },
        "trace": { "type": "object" }
      }
    },
    "stats": {
      "type": "object",
      "required": [
        "elapsedMs",
        "stageTimings",
        "apiCalls",
        "llmCalls",
        "tokenUsage",
        "stopReason",
        "configHash"
      ],
      "properties": {
        "elapsedMs": { "type": "integer", "minimum": 0, "maximum": 50000 },
        "stageTimings": { "type": "object" },
        "apiCalls": { "type": "integer", "minimum": 0, "maximum": 10 },
        "llmCalls": { "type": "integer", "minimum": 0 },
        "tokenUsage": { "type": "object" },
        "stopReason": { "type": "string" },
        "configHash": { "type": "string" }
      }
    }
  }
}
